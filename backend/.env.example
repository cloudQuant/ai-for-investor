APP_NAME=ai-for-investor
APP_VERSION=0.1.0
DEBUG=true
SITE_URL=http://localhost:3000

SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_TIMEOUT_HOURS=24

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_for_investor
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ai_for_investor

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_for_investor

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

GITHUB_TOKEN=

TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

SENTRY_DSN=

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MINUTES=1

TOOL_CONTAINER_CPU_LIMIT=1
TOOL_CONTAINER_MEMORY_MB=1024
TOOL_CONTAINER_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
